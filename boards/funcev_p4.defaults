# ESP32-P4 Function EV Board (board v1.5.2, chip rev v3.2; 16 MB flash, 32 MB PSRAM).
#
# This is an OVERLAY applied on top of sdkconfig.defaults - it only carries the
# deltas from the Waveshare ESP32-P4-ETH build. Build it with:
#
#   idf.py -B build.funcev \
#     -D SDKCONFIG=build.funcev/sdkconfig \
#     -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;boards/funcev_p4.defaults" \
#     build
#
# (Plain `idf.py build` still builds the Waveshare v1.3 image, unchanged.)

# --- chip revision ----------------------------------------------------------
# The base pins the target to rev <3.0 for the Waveshare v1.3 board. This board
# is rev v3.2, and rev <3.0 / >=3.0 are mutually exclusive targets, so drop the
# cap and target rev >=3.0. min-rev >=300 is also what compiles the esp_h264
# encoder's RGB-direct path in (no PPA colour convert), which is faster at 1080p.
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=n
CONFIG_ESP32P4_REV_MIN_300=y

# --- flash / partitions -----------------------------------------------------
# 16 MB here vs 32 MB on the P4-ETH: the 32 MB table does not fit, so use the
# shared 16 MB table (same app/OTA slots, smaller data tail).
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16mb.csv"

# --- updates ----------------------------------------------------------------
# This board has its own build, hence its own manifest. Without this, the funcev
# device would default to the root (Waveshare) manifest and try to OTA a rev<3.0
# image, which will not boot on this rev v3.2 chip.
CONFIG_KVM_UPDATE_URL="https://espkvm.github.io/espkvm/firmware/funcev/manifest.json"

# --- WiFi (via the onboard ESP32-C6) ----------------------------------------
# The P4 has no radio; this board carries an ESP32-C6-MINI-1 reached over SDIO,
# running Espressif's esp-hosted slave firmware (ships pre-flashed, v0.0.6). WiFi
# then works through esp_wifi_remote (the drop-in esp_wifi API). CONFIG_KVM_WIFI
# pulls in esp_wifi_remote + esp_hosted (gated in kvm_net/idf_component.yml) and
# compiles kvm_net/wifi.c; the board symbol wires the documented SDIO pins
# (CLK 18, CMD 19, D0-3 14/15/16/17, slave-reset 54). The Waveshare board has no
# C6, so it leaves CONFIG_KVM_WIFI=n and never fetches these. Ethernet stays the
# primary link; WiFi is the fallback.
CONFIG_KVM_WIFI=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

# --- board pins -------------------------------------------------------------
# This board's microSD slot is always powered (no power-gate GPIO).
CONFIG_KVM_SD_PWR_GPIO=-1

# These match the Waveshare defaults, so no override is needed:
#   I2C SDA/SCL 7/8, microSD CLK/CMD/D0-D3 43/44/39/40/41/42,
#   Ethernet IP101 MDC31 MDIO52 REFCLK50(EXT_IN) PHY_reset51 PHY_addr1.
#
# The RMII data pins and the BOOT button come from the board schematic; if a
# board differs from the values below, uncomment and correct them:
# CONFIG_KVM_ETH_RMII_TX_EN_GPIO=49
# CONFIG_KVM_ETH_RMII_TXD0_GPIO=34
# CONFIG_KVM_ETH_RMII_TXD1_GPIO=35
# CONFIG_KVM_ETH_RMII_CRS_DV_GPIO=28
# CONFIG_KVM_ETH_RMII_RXD0_GPIO=29
# CONFIG_KVM_ETH_RMII_RXD1_GPIO=30
# CONFIG_KVM_BUTTON_GPIO=35   # set to -1 if there is no reachable BOOT button

# Round GC9A01 SPI LCD: its GPIO pins are runtime settings (Settings -> Display).


CONFIG_KVM_GC9A01_SPI_HOST=2

# Log over USB-serial-JTAG (the same port used for flashing), so the console log
# is readable without a UART adapter - and GPIO 37/38 that the UART console would
# use become free pins.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
